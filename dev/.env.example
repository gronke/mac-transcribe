# Local BBB development environment.
# Copy to dev/bbb-docker/.env (done automatically by dev/start.sh).

# --- Connection ---
# DOMAIN=bbb.example.com
# LETSENCRYPT_EMAIL=admin@example.com
# Auto-detected by start.sh — set manually if needed.
EXTERNAL_IPv4=__DETECT__
EXTERNAL_IPv6=
STUN_IP=__DETECT__
STUN_PORT=3478

# --- Features ---
ENABLE_HTTPS_PROXY=true
ENABLE_GREENLIGHT=true
ENABLE_COTURN=true
ENABLE_COLLABORA=false
ENABLE_RECORDING=false
REMOVE_OLD_RECORDING=false
RECORDING_MAX_AGE_DAYS=14

# --- Secrets (safe for local dev only) ---
SHARED_SECRET=local-dev-secret
ETHERPAD_API_KEY=local-etherpad-key
RAILS_SECRET=localrailssecretlocalrailssecretlocalrailssecretlocalrailssecret
POSTGRESQL_SECRET=localpostgres
FSESL_PASSWORD=localfsesl
TURN_SECRET=localturn

# --- Misc ---
SIP_IP_ALLOWLIST=
WELCOME_MESSAGE=Welcome to the local dev BBB instance.
WELCOME_FOOTER=Local development server.
DEFAULT_PRESENTATION=./mod/nginx/default.pdf
SOUNDS_LANGUAGE=en-us-callie
DISABLE_SOUND_MUTED=false
DISABLE_SOUND_ALONE=false
ENABLE_LEARNING_DASHBOARD=false
